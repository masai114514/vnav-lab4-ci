<launch>
  <!-- Launch trajectory generation node -->
  <node name="trajectory_generation_node" pkg="trajectory_generation" type="trajectory_generation_node" output="screen" />

  <!-- Launch our controller -->
  <node name="controller_node" pkg="controller_pkg" type="controller_node" />

  <!-- Controller gains: copied from lab 3 (tuned, see lab3/sim/out/fig3_tuning.png) -->
  <param name="kx"     type="double" value="16.0"  />
  <param name="kv"     type="double" value="8.0"   />
  <param name="kr"     type="double" value="150.0" />
  <param name="komega" type="double" value="15.0"  />
</launch>
